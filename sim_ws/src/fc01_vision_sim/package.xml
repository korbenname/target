<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fc01_vision_sim</name>
  <version>0.1.0</version>
  <description>
    MuJoCo simulation of the fc01 impact drone: RMUC scene, FPV camera,
    quadrotor plant and platform-state topics. This package is the simulation
    bringup; it starts the image-based vision node and the mission node and
    applies /visioncontrol like a flight controller. Real-aircraft bringup
    lives in fc01_bringup.
  </description>
  <maintainer email="han@example.com">han</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>fc01_vision</exec_depend>
  <exec_depend>fc01_mission</exec_depend>
  <!-- MuJoCo is pip-installed: python3 -m pip install mujoco -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
